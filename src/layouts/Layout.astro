---
import "../styles/global.css";
import "@phosphor-icons/web/regular/style.css";

const site = "https://www.fers-retirement-calculator.com";
const {
  title,
  description,
  canonical = `${site}/`,
  schema,
  noindex = false,
  bare = false,
  updatedTime = "2026-08-14",
} = Astro.props;

const navItems = [
  { href: "#calculator", label: "Calculator" },
  { href: "#formula", label: "Formula" },
  { href: "#scenarios", label: "Scenarios" },
  { href: "#faq", label: "FAQ" },
];

const footerNavItems = [
  ...navItems,
  { href: "#mra-10", label: "MRA+10" },
  { href: "#supplement", label: "Supplement" },
  { href: "#worked-examples", label: "Examples" },
  { href: "#deferred-postponed", label: "Retirement types" },
  { href: "#csrs-offset", label: "CSRS" },
  { href: "#checklist", label: "Checklist" },
  { href: "#sources", label: "Sources" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173a52" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="FERS Retirement Calculator" />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="FERS Retirement Calculator preview" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:updated_time" content={updatedTime} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <meta name="twitter:image:alt" content="FERS Retirement Calculator preview" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to main content
    </a>
    {!bare && (
      <header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur">
        <div class="page-shell flex h-16 items-center justify-between">
          <a href="#calculator" class="flex items-center gap-2 font-semibold tracking-normal text-ink">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-white">
              <i class="ph ph-calculator text-lg" aria-hidden="true"></i>
            </span>
            <span>FERS Retirement Calculator</span>
          </a>
          <nav aria-label="Page sections" class="hidden items-center gap-6 text-sm font-medium text-muted lg:flex">
            {navItems.map((item) => (
              <a href={item.href} class="transition-colors hover:text-primary">{item.label}</a>
            ))}
          </nav>
        </div>
        <nav
          aria-label="Page sections mobile"
          class="page-shell flex h-11 items-center gap-5 overflow-x-auto text-sm font-medium text-muted lg:hidden"
        >
          {navItems.map((item) => (
            <a href={item.href} class="inline-flex shrink-0 items-center self-stretch transition-colors hover:text-primary">
              {item.label}
            </a>
          ))}
        </nav>
      </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!bare && (
      <footer class="border-t border-line bg-surface">
        <div class="page-shell flex flex-col gap-6 py-8 text-sm text-muted md:flex-row md:items-start md:justify-between">
          <div class="max-w-md">
            <p class="font-semibold text-ink">FERS Retirement Calculator</p>
            <p class="mt-2 text-xs leading-relaxed">
              A free educational estimator for federal employees. Calculations run in your browser and are not an official OPM benefit determination.
            </p>
          </div>
          <nav aria-label="Footer sections" class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-muted">
            {footerNavItems.map((item) => (
              <a href={item.href} class="inline-flex min-h-[44px] items-center transition-colors hover:text-primary">
                {item.label}
              </a>
            ))}
            <button
              type="button"
              id="disclaimer-open"
              class="inline-flex min-h-[44px] items-center text-left transition-colors hover:text-primary"
            >
              Disclaimer
            </button>
          </nav>
        </div>
      </footer>
    )}

    <div
      id="disclaimer-dialog"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/50 p-4 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-labelledby="disclaimer-dialog-title"
      data-open="false"
    >
      <div class="max-h-[85vh] w-full max-w-xl overflow-y-auto rounded-xl border border-line bg-surface p-6 sm:p-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-normal text-accent">Disclaimer</p>
            <h2 id="disclaimer-dialog-title" class="mt-2 text-2xl font-semibold tracking-tight text-ink">
              Educational estimate, not an official determination.
            </h2>
          </div>
          <button
            type="button"
            id="disclaimer-close"
            aria-label="Close disclaimer"
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-line text-ink transition hover:bg-canvas"
          >
            <i class="ph ph-x text-lg" aria-hidden="true"></i>
          </button>
        </div>

        <p class="mt-5 text-sm leading-relaxed text-muted">
          This is an independent educational estimate, not an official OPM benefit determination. FERS rules and amounts can vary based on your official service record, agency, special provisions, and current law. Before making a retirement decision, verify your numbers with your HR office and OPM.
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-line bg-canvas/50 p-4">
            <h3 class="text-sm font-semibold text-ink">This tool does not</h3>
            <ul class="mt-3 space-y-2 text-xs leading-relaxed text-muted">
              <li>Replace an official OPM annuity computation.</li>
              <li>Provide legal, tax, or financial advice.</li>
              <li>Guarantee any future benefit amount.</li>
            </ul>
          </div>
          <div class="rounded-lg border border-line bg-canvas/50 p-4">
            <h3 class="text-sm font-semibold text-ink">What to verify</h3>
            <ul class="mt-3 space-y-2 text-xs leading-relaxed text-muted">
              <li>Your retirement system and service computation date.</li>
              <li>Leave balances and military service credit.</li>
              <li>Survivor benefit elections and beneficiary forms.</li>
            </ul>
          </div>
        </div>

        <p class="mt-5 text-xs leading-relaxed text-muted">
          For an official determination, contact your agency HR or benefits office, or visit
          <a
            href="https://www.opm.gov/retirement-center/fers-information/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-primary hover:underline"
          >
            OPM FERS Information
          </a>.
        </p>
      </div>
    </div>

    <script>
      const dialog = document.getElementById("disclaimer-dialog");
      const openButton = document.getElementById("disclaimer-open");
      const closeButton = document.getElementById("disclaimer-close");

      function openDialog() {
        if (!dialog || !openButton) return;
        dialog.classList.remove("hidden");
        dialog.classList.add("flex");
        dialog.dataset.open = "true";
        document.body.style.overflow = "hidden";
        closeButton?.focus();
      }

      function closeDialog() {
        if (!dialog || !openButton) return;
        dialog.classList.add("hidden");
        dialog.classList.remove("flex");
        dialog.dataset.open = "false";
        document.body.style.overflow = "";
        openButton?.focus();
      }

      openButton?.addEventListener("click", openDialog);
      closeButton?.addEventListener("click", closeDialog);

      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) closeDialog();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && dialog?.dataset.open === "true") {
          closeDialog();
        }
      });
    </script>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </body>
</html>
