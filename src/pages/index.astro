              <th class="px-4 py-3 font-semibold">Spouse benefit</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <tr>
              <td class="px-4 py-4 font-semibold text-ink">No survivor benefit</td>
              <td class="px-4 py-4 text-muted">0%</td>
              <td class="px-4 py-4 text-muted">No spouse annuity</td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-semibold text-ink">Partial survivor benefit</td>
              <td class="px-4 py-4 text-muted">5%</td>
              <td class="px-4 py-4 text-muted">25% of the unreduced annuity</td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-semibold text-ink">Full survivor benefit</td>
              <td class="px-4 py-4 text-muted">10%</td>
              <td class="px-4 py-4 text-muted">50% of the unreduced annuity</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
