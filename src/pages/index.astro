---
import Layout from "../layouts/Layout.astro";
import FersCalculator from "../components/FersCalculator.astro";
import RetirementTypeChecker from "../components/RetirementTypeChecker.astro";

const title = "FERS Retirement Calculator: Estimate Your Federal Pension";
const description =
  "Free FERS retirement calculator for federal employees. Check eligibility, estimate pension, FERS Supplement, survivor benefit, and compare retirement dates.";
const lastReviewed = "2026-08-14";

const faqs = [
  {
    question: "How is the FERS pension calculated?",
    answer:
      "High-3 average salary x years of creditable service x multiplier: 1% per year, rising to 1.1% at 62 or later with 20+ years. Special category employees earn 1.7% for their first 20 years.",
  },
  {
    question: "What is the High-3 Average Salary?",
    answer:
      "High-3 is the highest average basic pay from any 36 consecutive months of service, usually your final three years. It includes basic pay and locality pay, and excludes overtime, bonuses, and most premium pay.",
  },
  {
    question: "Does unused sick leave increase my FERS pension?",
    answer:
      "Yes. Unused sick leave converts to creditable service at 2,087 hours per year and can increase the annuity amount, but it cannot by itself make you eligible to retire.",
  },
  {
    question: "What is the FERS MRA+10 retirement?",
    answer:
      "MRA+10 lets you retire at your Minimum Retirement Age with at least 10 years of service. Benefits that begin before 62 are reduced 5% per year, unless you have 30 years of service or begin at age 60 with 20 or more years.",
  },
  {
    question: "What is the FERS Special Retirement Supplement?",
    answer:
      "An extra payment for eligible retirees who start benefits before age 62, approximated as your estimated Social Security benefit at 62 multiplied by FERS service divided by 40. It ends at age 62.",
  },
  {
    question: "How does the survivor benefit reduce my FERS annuity?",
    answer:
      "A full survivor benefit reduces your annuity 10% and pays your spouse 50% of the unreduced amount. Partial: 5% for 25%. No election: unreduced annuity, no spouse benefit.",
  },
  {
    question: "Does this calculator account for military service buyback?",
    answer:
      "Yes, but only military time for which a deposit has been paid counts as creditable service. Do not enter unpaid military time.",
  },
  {
    question: "What is the difference between deferred and postponed retirement?",
    answer:
      "Deferred: you left federal service before immediate eligibility and collect later. Postponed: you are already eligible but delay the start, often to avoid the MRA+10 penalty or restore FEHB.",
  },
  {
    question: "Can the FERS Supplement be reduced by earned income?",
    answer:
      "Yes. The Supplement is subject to an earnings test before age 62 — income above the annual limit can reduce or eliminate it. This calculator does not apply the earnings test.",
  },
  {
    question: "Does this calculator work for CSRS or CSRS-Offset employees?",
    answer:
      "Not reliably. It uses FERS formulas; CSRS and CSRS-Offset use different multipliers. The system selector shows a warning — verify any estimate with OPM or HR.",
  },
  {
    question: "Can I retire at age 60 with 20 years of FERS service?",
    answer:
      "Yes. Age 60 with at least 20 years of creditable service is an immediate, unreduced FERS retirement. Retiring at 62 or later with 20 or more years also raises the multiplier from 1.0% to 1.1%.",
  },
  {
    question: "Is this estimate my official FERS benefit?",
    answer:
      "No. This is an educational estimate. Your official annuity is determined by OPM and your agency from your official personnel and pay records.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.fers-retirement-calculator.com/#webpage",
      url: "https://www.fers-retirement-calculator.com/",
      name: title,
      description,
      inLanguage: "en",
      datePublished: lastReviewed,
      dateModified: lastReviewed,
      mainEntity: {
        "@id": "https://www.fers-retirement-calculator.com/#app",
      },
      about: {
        "@id": "https://www.fers-retirement-calculator.com/#app",
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.fers-retirement-calculator.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "FERS Retirement Calculator",
          item: "https://www.fers-retirement-calculator.com/#calculator",
        },
      ],
    },
    {
      "@type": "WebApplication",
      "@id": "https://www.fers-retirement-calculator.com/#app",
      name: "FERS Retirement Calculator",
      url: "https://www.fers-retirement-calculator.com/",
      description,
      inLanguage: "en",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Web",
      browserRequirements: "Requires JavaScript",
      isAccessibleForFree: true,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      featureList: [
        "FERS pension estimate",
        "Retirement eligibility snapshot",
        "High-3 salary input",
        "Creditable service calculation",
        "Unused sick leave conversion",
        "Military buyback service credit",
        "Special category multiplier",
        "Survivor benefit reduction",
        "Survivor benefit comparison",
        "FERS Supplement estimate",
        "Replacement rate analysis",
        "MRA+10 comparison",
        "Retirement age scenario switching",
        "Shareable estimate link",
      ],
    },
    {
      "@type": "TechArticle",
      "@id": "https://www.fers-retirement-calculator.com/#article",
      headline: "How the FERS Retirement Formula Works",
      description,
      articleSection: [
        "FERS formula",
        "High-3 salary",
        "Creditable service",
        "FERS Supplement",
        "Survivor benefit",
        "Deferred retirement",
        "Postponed retirement",
        "FERS COLA",
      ],
      inLanguage: "en",
      datePublished: lastReviewed,
      dateModified: lastReviewed,
      author: {
        "@id": "https://www.fers-retirement-calculator.com/#organization",
      },
      publisher: {
        "@id": "https://www.fers-retirement-calculator.com/#organization",
      },
      about: {
        "@id": "https://www.fers-retirement-calculator.com/#app",
      },
      mainEntityOfPage: {
        "@id": "https://www.fers-retirement-calculator.com/#webpage",
      },
    },
    {
      "@type": "FAQPage",
      inLanguage: "en",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        inLanguage: "en",
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
          inLanguage: "en",
        },
      })),
    },
    {
      "@type": "Organization",
      "@id": "https://www.fers-retirement-calculator.com/#organization",
      name: "FERS Retirement Calculator",
      url: "https://www.fers-retirement-calculator.com/",
      logo: "https://www.fers-retirement-calculator.com/favicon.svg",
      email: "hello@fers-retirement-calculator.com",
      sameAs: ["https://github.com/jiusongvip/fers-retirement-calculator"],
      contactPoint: [
        {
          "@type": "ContactPoint",
          contactType: "customer support",
          email: "hello@fers-retirement-calculator.com",
          url: "https://www.fers-retirement-calculator.com/contact/",
        },
      ],
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="https://www.fers-retirement-calculator.com/"
  schema={schema}
  updatedTime={lastReviewed}
>
  <section class="relative overflow-hidden bg-surface">
    <div class="pointer-events-none absolute inset-0 hero-sheen" aria-hidden="true"></div>
    <div class="page-shell relative grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">
      <div>
        <p class="flex items-center gap-2.5 text-sm font-semibold uppercase tracking-wider text-accent">
          <i class="ph ph-star-four text-base" aria-hidden="true"></i>
          Federal retirement planning
        </p>
        <h1 class="mt-5 max-w-2xl text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          FERS Retirement Calculator
        </h1>
        <p class="mt-5 max-w-xl text-lg font-medium leading-relaxed text-ink">
          Know your federal pension before you decide.
        </p>
        <p class="mt-2 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
          Estimate your FERS annuity, compare retirement dates, and understand the rule behind every number. Free, private, and no sign-up required.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#calculator"
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-primary-hover active:translate-y-px"
          >
            <i class="ph ph-calculator text-lg" aria-hidden="true"></i>
            Estimate your pension
          </a>
          <a
            href="#formula"
            class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-6 py-3.5 text-sm font-semibold text-ink transition hover:bg-canvas active:translate-y-px"
          >
            See how the formula works
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-medium text-muted">
          <li class="inline-flex items-center gap-2">
            <i class="ph ph-check-circle text-lg text-positive" aria-hidden="true"></i>
            Free
          </li>
          <li class="inline-flex items-center gap-2">
            <i class="ph ph-lock-simple text-lg text-positive" aria-hidden="true"></i>
            No sign-up
          </li>
          <li class="inline-flex items-center gap-2">
            <i class="ph ph-eye-slash text-lg text-positive" aria-hidden="true"></i>
            Private
          </li>
          <li class="inline-flex items-center gap-2">
            <i class="ph ph-browser text-lg text-positive" aria-hidden="true"></i>
            Runs in your browser
          </li>
        </ul>

        <div class="mt-8 max-w-xl rounded-xl border border-line bg-canvas/60 p-5">
          <p class="text-sm font-semibold text-ink">Quick answer</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            The FERS basic annuity is
            <span class="font-mono font-semibold text-ink">
              High-3 × Years of Creditable Service × Multiplier
            </span>.
            This calculator also includes unused sick leave, military buyback, special category rules, survivor benefits, FERS Supplement, and a comparison of retiring at MRA+10, 60, or 62.
          </p>
        </div>
      </div>

      <div class="hidden lg:block">
        <div class="overflow-hidden rounded-2xl border border-line bg-canvas/70 shadow-[0_28px_80px_rgba(23,42,58,0.12)]">
          <div class="relative aspect-[3/2] overflow-hidden">
            <img
              src="/hero.webp"
              alt="Federal retirement planning at a peaceful desk with planning documents"
              width="1170"
              height="780"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/30 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-3">
              <p class="text-sm font-semibold uppercase tracking-wider text-white drop-shadow">Your FERS benefit</p>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-surface/90 px-3 py-1 text-xs font-semibold text-ink backdrop-blur">
                <i class="ph ph-calculator text-sm text-accent" aria-hidden="true"></i>
                Free tool
              </span>
            </div>
          </div>

          <div class="p-6">
            <div class="grid gap-3">
              <div class="flex items-start gap-3 rounded-xl border border-line bg-surface p-4">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <i class="ph ph-bank text-lg" aria-hidden="true"></i>
                </span>
                <div>
                  <p class="text-sm font-semibold text-ink">FERS basic annuity</p>
                  <p class="mt-1 text-xs leading-relaxed text-muted">A predictable pension based on your High-3 salary and creditable service.</p>
                </div>
              </div>
              <div class="flex items-start gap-3 rounded-xl border border-line bg-surface p-4">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <i class="ph ph-gauge text-lg" aria-hidden="true"></i>
                </span>
                <div>
                  <p class="text-sm font-semibold text-ink">FERS Supplement</p>
                  <p class="mt-1 text-xs leading-relaxed text-muted">A bridge payment for some retirees who start benefits before age 62.</p>
                </div>
              </div>
              <div class="flex items-start gap-3 rounded-xl border border-line bg-surface p-4">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <i class="ph ph-trend-up text-lg" aria-hidden="true"></i>
                </span>
                <div>
                  <p class="text-sm font-semibold text-ink">Social Security + TSP</p>
                  <p class="mt-1 text-xs leading-relaxed text-muted">The other two legs of FERS. Plan them together, not in isolation.</p>
                </div>
              </div>
            </div>

            <p class="mt-5 rounded-xl border border-accent/20 bg-accent-soft px-4 py-3 text-xs leading-relaxed text-accent">
              The basic annuity formula: High-3 × Creditable Service × Multiplier.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="calculator-section" class="bg-canvas">
    <div class="page-shell py-14 sm:py-16">
      <FersCalculator lastReviewed={lastReviewed} />
    </div>
  </section>

  <section id="how-it-works" class="border-t border-line bg-surface">
    <div class="page-shell section-pad">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
        <div>
          <p class="text-sm font-semibold uppercase tracking-normal text-accent">How it works</p>
          <h2 class="mt-4 text-3xl font-semibold leading-tight tracking-normal text-ink sm:text-4xl">
            Three numbers give you a starting point.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-muted">
            The basic FERS formula is simple. The detail is in what counts as salary, service, and the right multiplier.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg border border-line bg-canvas/50 p-6">
            <p class="text-lg font-semibold text-accent">01</p>
            <h3 class="mt-4 text-base font-semibold text-ink">High-3 salary</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              The highest average basic pay from any 36 consecutive months of federal service.
            </p>
          </div>
          <div class="rounded-lg border border-line bg-canvas/50 p-6">
            <p class="text-lg font-semibold text-accent">02</p>
            <h3 class="mt-4 text-base font-semibold text-ink">Creditable service</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              FERS-covered years, unused sick leave, and military time after buyback.
            </p>
          </div>
          <div class="rounded-lg border border-line bg-canvas/50 p-6">
            <p class="text-lg font-semibold text-accent">03</p>
            <h3 class="mt-4 text-base font-semibold text-ink">Multiplier</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              1%, 1.1%, or special category rates depending on age, service, and position.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-10 rounded-lg border border-line bg-canvas/50 p-6">
        <h3 class="text-base font-semibold text-ink">How the MRA+10 reduction works</h3>
        <p class="mt-3 font-mono text-sm font-semibold leading-7 text-accent">
          Reduction = 5% x full years under age 62 + (5% / 12) x additional months
        </p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          5% for each full year under age 62, prorated monthly.
        </p>
      </div>
    </div>
  </section>

  <section id="formula" class="section-pad">
    <div class="page-shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-normal text-accent">FERS formula</p>
        <h2 class="mt-4 text-3xl font-semibold leading-tight tracking-normal text-ink sm:text-4xl">
          One formula, three multipliers.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-muted">
          The basic FERS annuity is High-3 average salary x creditable service x the correct multiplier.
        </p>
        <div class="mt-6 rounded-lg border border-line bg-surface p-6">
          <p class="font-mono text-sm font-semibold leading-7 text-ink">Annual Pension = High-3 x Service x Multiplier</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Example: a $100,000 High-3 with 25 years of service at 1.1% gives $27,500 per year.
          </p>
        </div>
        <img
          src="/fers-annuity-formula.svg"
          alt="FERS annuity formula: High-3 average salary times creditable service times multiplier equals annual FERS pension."
          width="720"
          height="200"
          class="mt-6 h-auto w-full max-w-xl rounded-lg border border-line bg-surface"
        />
      </div>
      <div class="overflow-x-auto rounded-lg border border-line bg-surface">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="bg-canvas text-muted">
            <tr>
              <th class="px-4 py-3 font-semibold">Situation</th>
              <th class="px-4 py-3 font-semibold">Multiplier</th>
              <th class="px-4 py-3 font-semibold">When it applies</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <tr>
              <td class="px-4 py-4 font-semibold text-ink">Standard FERS</td>
              <td class="px-4 py-4 text-accent">1.0%</td>
              <td class="px-4 py-4 text-muted">Most employees who retire before age 62, or at 62+ with less than 20 years.</td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-semibold text-ink">Enhanced</td>
              <td class="px-4 py-4 text-accent">1.1%</td>
              <td class="px-4 py-4 text-muted">Age 62 or later with at least 20 years of service.</td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-semibold text-ink">Special category</td>
              <td class="px-4 py-4 text-accent">1.7% / 1.0%</td>
              <td class="px-4 py-4 text-muted">First 20 years at 1.7%, then 1% for LEO, ATC, firefighters, and nuclear materials couriers.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <figure class="col-span-full mt-6 rounded-lg border border-line bg-canvas/50 p-6">
        <blockquote class="text-sm leading-relaxed text-muted">
          &ldquo;1 percent of his average pay &hellip; is the annuity for each year of creditable service&rdquo; &mdash; and, for an employee with at least 20 years of creditable service whose annuity commences at age 62 or later, &ldquo;1.1 percent of his average pay is the annuity for each year of such service&rdquo;.
        </blockquote>
        <figcaption class="mt-3 text-xs font-semibold text-ink">
          &mdash; <cite class="not-italic">5 U.S.C. &sect; 8417(a)</cite>, computation of the basic FERS annuity &middot;
          <a
            href="https://www.law.cornell.edu/uscode/text/5/8417"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary underline decoration-primary/40 underline-offset-2 hover:decoration-primary"
          >Read the statute</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="mra-10" class="border-t border-line bg-surface">
    <div class="page-shell section-pad">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="text-sm font-semibold uppercase tracking-normal text-accent">MRA+10</p>
          <h2 class="mt-4 text-3xl font-semibold leading-tight tracking-normal text-ink sm:text-4xl">
            Early retirement has a cost.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-muted">
            You can retire at MRA with 10 years of service, but beginning benefits before 62 can reduce your annuity by 5% per year, under
            <a
              href="https://www.ecfr.gov/current/title-5/chapter-III/subchapter-B/part-843"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-primary hover:underline"
            >
              5 CFR Part 843</a>.
          </p>
          <div class="mt-6 rounded-lg border border-line bg-canvas/50 p-6">
            <p class="text-sm font-semibold text-ink">No reduction when:</p>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
              <li>You have at least 30 years of service.</li>
              <li>You have at least 20 years of service and begin at age 60.</li>
            </ul>
          </div>
        </div>
        <div class="overflow-x-auto rounded-lg border border-line bg-surface">
          <table class="w-full min-w-[560px] text-left text-sm">
            <thead class="bg-canvas text-muted">
              <tr>
                <th class="px-4 py-3 font-semibold">Birth year</th>
                <th class="px-4 py-3 font-semibold">Minimum Retirement Age</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <tr>
                <td class="px-4 py-4 font-semibold text-ink">1970 or later</td>
                <td class="px-4 py-4 text-muted">57</td>
              </tr>
              <tr>
                <td class="px-4 py-4 font-semibold text-ink">1969</td>
                <td class="px-4 py-4 text-muted">56 years 10 months</td>
              </tr>
              <tr>
                <td class="px-4 py-4 font-semibold text-ink">1965 to 1968</td>
                <td class="px-4 py-4 text-muted">56 years 2 to 8 months</td>
              </tr>
              <tr>
                <td class="px-4 py-4 font-semibold text-ink">1953 to 1964</td>
                <td class="px-4 py-4 text-muted">56</td>
              </tr>
              <tr>
                <td class="px-4 py-4 font-semibold text-ink">1948 to 1952</td>
                <td class="px-4 py-4 text-muted">55 years 2 to 10 months</td>
              </tr>
              <tr>
                <td class="px-4 py-4 font-semibold text-ink">Before 1948</td>
                <td class="px-4 py-4 text-muted">55</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section id="supplement" class="section-pad">
    <div class="page-shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-normal text-accent">FERS Supplement</p>
        <h2 class="mt-4 text-3xl font-semibold leading-tight tracking-normal text-ink sm:text-4xl">
          A bridge before Social Security.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-muted">
          Eligible employees who retire before 62 may receive the FERS Special Retirement Supplement. It is not Social Security and ends at age 62.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg border border-line bg-surface p-6">
          <h3 class="text-base font-semibold text-ink">Who may be eligible</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Immediate retirement eligibility: 30 years of service, 20 years at age 60, or certain special category retirements.
          </p>
        </div>
        <div class="rounded-lg border border-line bg-surface p-6">
          <h3 class="text-base font-semibold text-ink">Approximate method</h3>
          <p class="mt-3 font-mono text-sm font-semibold leading-7 text-accent">
            Social Security at 62 x FERS Years / 40
          </p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Applies only when the scenario appears eligible; an earnings test before 62 can reduce or end the actual payment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="worked-examples" class="section-pad">
