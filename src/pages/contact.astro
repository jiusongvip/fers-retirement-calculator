---
import Layout from "../layouts/Layout.astro";

const title = "Contact - FERS Retirement Calculator";
const description =
  "Contact the FERS Retirement Calculator team for corrections, feedback, or questions about the calculator. Email hello@fers-retirement-calculator.com.";
const updated = "2026-09-10";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  description: description,
  url: "https://www.fers-retirement-calculator.com/contact/",
  inLanguage: "en",
  dateModified: updated,
};
---

<Layout
  title={title}
  description={description}
  canonical="https://www.fers-retirement-calculator.com/contact/"
  schema={schema}
  updatedTime={updated}
>
  <section class="hero-sheen border-b border-line bg-surface">
    <div class="page-shell py-14 sm:py-16">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">Contact</p>
      <h1 class="mt-4 max-w-2xl text-balance text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Get in touch
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Corrections, feedback, and questions about the calculator are all welcome.
      </p>
    </div>
  </section>

  <section class="section-pad">
    <div class="page-shell max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Email</h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        The fastest way to reach the team is email at
        <a href="mailto:hello@fers-retirement-calculator.com" class="font-semibold text-primary hover:underline">hello@fers-retirement-calculator.com</a>.
        We read every message and aim to reply within a few business days.
      </p>

      <h2 class="mt-10 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Report a calculation issue</h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        If an estimate or explanation does not match official OPM guidance, include the inputs you used (High-3, years of
        service, retirement age, survivor election) and the rule you believe applies. Reports citing OPM's FERS Computation
        guidance or the governing statute are fixed fastest.
      </p>

      <h2 class="mt-10 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">What we cannot help with</h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        This is an educational tool, not a benefits counselor. We cannot interpret your official service record, tell you when to
        retire, or provide legal, tax, or financial advice. For personal benefit questions, contact your agency HR office, your
        servicing retirement counselor, or OPM directly.
      </p>

      <h2 class="mt-10 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Other resources</h2>
      <ul class="mt-4 grid gap-2 text-base leading-relaxed text-muted">
        <li><a href="/about/" class="font-semibold text-primary hover:underline">About the project</a> — who builds this calculator and why.</li>
        <li><a href="/privacy/" class="font-semibold text-primary hover:underline">Privacy policy</a> — what data the site does and does not collect.</li>
        <li><a href="/terms/" class="font-semibold text-primary hover:underline">Terms of use</a> — how the estimates may be used.</li>
      </ul>
    </div>
  </section>
</Layout>
